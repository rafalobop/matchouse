# API Key para Google Gemini (gemini-2.5-flash-lite)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ID de la planilla de Google Sheets (se obtiene de la URL)
# Ejemplo: https://docs.google.com/spreadsheets/d/1A2B3C.../edit
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui

# Nombre de la pestaña donde está la cartera de propiedades
GOOGLE_CARTERA_TAB_NAME=Cartera

# Nombre de la pestaña donde se guardarán los matches encontrados
GOOGLE_MATCHES_TAB_NAME=[MATCHES ENCONTRADOS]

# Nombre del grupo de WhatsApp a filtrar (opcional, vacío para escuchar todos)
WHATSAPP_GROUP_NAME=Ventas Yerba Buena
