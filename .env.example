# =============================================
# HouseMatch — Variables de Entorno
# =============================================

# --- AI ---
# API Key para Google Gemini (modelo primario)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# API Key para OpenAI (fallback automático si Gemini falla)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Extracción de texto libre de formulario (matching ciego, KAN-36). Feature nueva sin
# consumidor todavía: deshabilitada por default, no afecta al extractor de WhatsApp.
FREE_TEXT_EXTRACTION_ENABLED=false

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_JWT_SECRET=tu_jwt_secret_aqui

# --- App ---
# URL pública de la app (usada para el redirect del magic link)
# Dev local: http://localhost:3000
# Producción Railway: https://tu-app.railway.app
APP_URL=http://localhost:3000

# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui
VAPID_EMAIL=mailto:info@housematch.com

# --- Notificaciones ---
# Canal por el que se notifican los matches calificados: whatsapp | email
# (email es la fuente primaria; whatsapp queda disponible detrás de este flag)
NOTIFICATION_CHANNEL=email

# Cada cuántos minutos corre el cron de notificación consolidada
NOTIFICATION_INTERVAL_MINUTES=20

# API Key de Resend (envío de notificaciones por email). Ver resend_implementation.md
# Nota: la variable se llama SENDER_API_KEY por convención histórica de este repo.
SENDER_API_KEY=tu_resend_api_key_aqui

# --- Limpieza de sesiones de WhatsApp de prueba (KAN-53) ---
# Allowlist explícita de tenant_id (UUID) de cuentas de WhatsApp/Baileys usadas solo para
# pruebas, separados por coma. Vacío por default: el servicio no hace nada si no se configura,
# nunca desconecta sesiones por heurística para evitar afectar a usuarios reales.
TEST_WHATSAPP_TENANT_IDS=

# Cada cuántos minutos corre el proceso que desconecta las sesiones de prueba activas
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Email de devs/testers al que avisar cuando se desconecta una sesión de prueba.
# Opcional: si no se configura (junto con SENDER_API_KEY), la notificación queda solo en los logs.
DEV_ALERT_EMAIL=
