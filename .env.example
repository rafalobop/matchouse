# =============================================
# HouseMatch — Variables de Entorno
# =============================================

# --- AI ---
# API Key para Google Gemini (modelo primario)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# API Key para OpenAI (fallback automático si Gemini falla)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Extracción de texto libre de formulario (matching ciego, KAN-36/KAN-38), usada por
# POST /api/search. Habilitada por default; no afecta al extractor de WhatsApp.
FREE_TEXT_EXTRACTION_ENABLED=true

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_JWT_SECRET=tu_jwt_secret_aqui
# KAN-122: sin SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY la app no arranca (fail-fast). Solo para
# desarrollo local sin Supabase configurado todavía: seteá esto explícito a "true" para arrancar
# igual (el dashboard va a mostrar un modal listando qué falta). NUNCA en producción.
# ALLOW_MISSING_SUPABASE_CREDENTIALS=true

# --- App ---
# URL pública de la app (usada para el redirect del magic link)
# Dev local: http://localhost:3000
# Producción Railway: https://tu-app.railway.app
APP_URL=http://localhost:3000

# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui
VAPID_EMAIL=mailto:info@housematch.com

# --- Notificaciones ---
# Único canal desde el retiro de WhatsApp/Baileys (2026-07-29): email.
# Cada cuántos minutos corre el cron de notificación consolidada
NOTIFICATION_INTERVAL_MINUTES=20

# API Key de Resend — REQUERIDA (fail-fast, 2026-08-22). Ver resend_implementation.md.
# Nota: la variable se llama SENDER_API_KEY por convención histórica de este repo.
# Ya no es solo el canal de notificaciones: el magic link (login de tenant y admin) también se
# manda por acá desde que dejó de mandarlo Supabase directo (ver notifier-email.ts) — sin esta
# key, el servidor no arranca.
SENDER_API_KEY=tu_resend_api_key_aqui

# --- Matching bidireccional (KAN-79) ---
# Secreto compartido de POST /internal/property-match-check — endpoint sin sesión de usuario,
# llamado por el trigger de Postgres (property_uploaded_trigger) vía pg_net cuando entra una
# propiedad nueva. El MISMO valor debe estar guardado en Supabase Vault como
# 'internal_webhook_secret' para que la función del trigger lo use al armar el header.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_WEBHOOK_SECRET=tu_secreto_interno_aqui

# --- Panel admin (app.admin.brokaza.com) ---
# Host exacto que activa el adminRouter. Sin esta variable, el panel admin queda deshabilitado
# por completo (útil en local/dev, donde no hay subdominio propio).
ADMIN_HOST=app.admin.brokaza.com

# URL a la que redirige el magic link del panel admin. Opcional: si no se setea, se arma como
# https://<ADMIN_HOST> (correcto en producción). En local, sin dominio/certificado propio, hay
# que setearla a algo como http://localhost:3000 para poder loguearse en el navegador.
# ADMIN_APP_URL=http://localhost:3000
