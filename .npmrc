# KAN-313: npm 12 endureció el default de `allow-remote`/`allow-git` a "none" (breaking change,
# ver https://github.com/npm/cli/commit/caa329568d32587e53f6e098f43b550dd2685034) — sin esto,
# `npm install`/`npm ci` fallan con EALLOWREMOTE al intentar instalar `xlsx`, declarado en
# package.json como tarball remoto (https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz, migrado
# del registro público en KAN-125 — SheetJS recomienda instalar desde su propio CDN, no npm).
#
# `allow-remote=root` (no `all`): permite URLs remotas SOLO si están declaradas directamente en
# el package.json raíz de este proyecto (como xlsx) — sigue bloqueando cualquier dependencia
# TRANSITIVA que intente colar una URL remota sin que nadie la note, que es el vector de
# supply-chain real que esta config existe para prevenir.
allow-remote=root
